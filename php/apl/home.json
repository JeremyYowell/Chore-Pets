{
  "type": "APL",
  "version": "1.6",
  "theme": "dark",
  "import": [
    { "name": "alexa-layouts", "version": "1.5.0" },
    { "name": "alexa-styles",  "version": "1.5.0" }
  ],
  "styles": {
    "cardBase": {
      "values": [
        {
          "borderRadius": 16,
          "padding": "20dp"
        }
      ]
    }
  },
  "mainTemplate": {
    "parameters": ["homeData"],
    "item": {
      "type": "Container",
      "width": "100vw",
      "height": "100vh",
      "backgroundColor": "#111827",
      "direction": "column",
      "items": [

        {
          "type": "Container",
          "backgroundColor": "#1f2937",
          "paddingLeft": "28dp",
          "paddingRight": "28dp",
          "paddingTop": "14dp",
          "paddingBottom": "14dp",
          "direction": "row",
          "alignItems": "center",
          "items": [
            {
              "type": "Text",
              "text": "⭐ Chore Pets",
              "fontSize": "28dp",
              "fontWeight": "700",
              "color": "#FCD34D",
              "grow": 1
            },
            {
              "type": "TouchWrapper",
              "onPress": {
                "type": "SendEvent",
                "arguments": ["openParentMenu"]
              },
              "item": {
                "type": "Container",
                "backgroundColor": "#374151",
                "borderRadius": "8dp",
                "paddingLeft": "14dp",
                "paddingRight": "14dp",
                "paddingTop": "6dp",
                "paddingBottom": "6dp",
                "items": [{
                  "type": "Text",
                  "text": "⚙️",
                  "fontSize": "22dp",
                  "textAlign": "center"
                }]
              }
            }
          ]
        },

        {
          "type": "Container",
          "grow": 1,
          "direction": "column",
          "alignItems": "center",
          "paddingLeft": "32dp",
          "paddingRight": "32dp",
          "paddingTop": "16dp",
          "paddingBottom": "24dp",
          "items": [
            {
              "type": "Text",
              "text": "Tap a name to see chores",
              "fontSize": "22dp",
              "fontWeight": "600",
              "color": "#D1D5DB",
              "textAlign": "center",
              "paddingBottom": "12dp"
            },
            {
              "type": "Sequence",
              "scrollDirection": "horizontal",
              "width": "100%",
              "grow": 1,
              "alignItems": "center",
              "data": "${homeData.children}",
              "item": {
                "type": "TouchWrapper",
                "marginLeft": "16dp",
                "marginRight": "16dp",
                "onPress": {
                  "type": "SendEvent",
                  "arguments": ["selectChild", "${data.childId}"]
                },
                "item": {
                  "type": "Container",
                  "backgroundColor": "${data.allDone ? '#14532d' : '#1e3a5f'}",
                  "borderRadius": "20dp",
                  "borderWidth": "2dp",
                  "borderColor": "${data.allDone ? '#4ade80' : '#3b82f6'}",
                  "width": "240dp",
                  "height": "360dp",
                  "direction": "column",
                  "alignItems": "center",
                  "justifyContent": "space-between",
                  "paddingTop": "20dp",
                  "paddingBottom": "20dp",
                  "paddingLeft": "16dp",
                  "paddingRight": "16dp",
                  "items": [

                    {
                      "type": "Text",
                      "text": "${data.name}",
                      "fontSize": "26dp",
                      "fontWeight": "700",
                      "color": "#F9FAFB",
                      "textAlign": "center"
                    },

                    {
                      "type": "Image",
                      "source": "${data.petImage}",
                      "width": "160dp",
                      "height": "180dp",
                      "scale": "best-fit",
                      "align": "center"
                    },

                    {
                      "type": "Text",
                      "text": "${data.stateLabel}",
                      "fontSize": "15dp",
                      "color": "#D1D5DB",
                      "textAlign": "center"
                    },

                    {
                      "type": "Container",
                      "backgroundColor": "${data.allDone ? '#166534' : '#1e40af'}",
                      "borderRadius": "24dp",
                      "paddingLeft": "16dp",
                      "paddingRight": "16dp",
                      "paddingTop": "8dp",
                      "paddingBottom": "8dp",
                      "alignItems": "center",
                      "items": [
                        {
                          "type": "Text",
                          "text": "${data.allDone ? '✅ All done!' : data.doneCount + '/' + data.totalCount + ' done'}",
                          "fontSize": "16dp",
                          "fontWeight": "700",
                          "color": "${data.allDone ? '#86efac' : '#93c5fd'}",
                          "textAlign": "center"
                        }
                      ]
                    }
                  ]
                }
              }
            }
          ]
        },

        {
          "type": "Container",
          "backgroundColor": "#0a0f1a",
          "paddingLeft": "28dp",
          "paddingRight": "28dp",
          "paddingTop": "7dp",
          "paddingBottom": "7dp",
          "alignItems": "center",
          "items": [{
            "type": "Text",
            "text": "Say \"Alexa, open Chore Pets\" to wake me up",
            "fontSize": "13dp",
            "color": "#4B5563",
            "textAlign": "center"
          }]
        }

      ]
    }
  }
}
