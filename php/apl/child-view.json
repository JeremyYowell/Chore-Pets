{
  "type": "APL",
  "version": "1.6",
  "theme": "dark",
  "import": [
    { "name": "alexa-layouts", "version": "1.5.0" },
    { "name": "alexa-styles",  "version": "1.5.0" }
  ],
  "mainTemplate": {
    "parameters": ["childData"],
    "item": {
      "type": "Container",
      "width": "100vw",
      "height": "100vh",
      "backgroundColor": "#111827",
      "direction": "column",
      "items": [

        {
          "type": "Container",
          "backgroundColor": "#1f2937",
          "paddingLeft": "20dp",
          "paddingRight": "20dp",
          "paddingTop": "12dp",
          "paddingBottom": "12dp",
          "direction": "row",
          "alignItems": "center",
          "items": [
            {
              "type": "TouchWrapper",
              "onPress": {
                "type": "SendEvent",
                "arguments": ["goHome"]
              },
              "item": {
                "type": "Container",
                "backgroundColor": "#374151",
                "borderRadius": "8dp",
                "paddingLeft": "16dp",
                "paddingRight": "16dp",
                "paddingTop": "8dp",
                "paddingBottom": "8dp",
                "marginRight": "20dp",
                "items": [
                  {
                    "type": "Text",
                    "text": "← Home",
                    "fontSize": "18dp",
                    "color": "#93C5FD",
                    "fontWeight": "600"
                  }
                ]
              }
            },
            {
              "type": "Text",
              "text": "${childData.name}'s Chores",
              "fontSize": "26dp",
              "fontWeight": "700",
              "color": "#F9FAFB",
              "grow": 1
            },
            {
              "type": "Text",
              "text": "${childData.doneCount}/${childData.totalCount} done today",
              "fontSize": "18dp",
              "color": "${childData.doneCount >= childData.totalCount && childData.totalCount > 0 ? '#4ADE80' : '#9CA3AF'}"
            }
          ]
        },

        {
          "type": "Container",
          "grow": 1,
          "direction": "row",
          "items": [

            {
              "type": "Container",
              "width": "340dp",
              "direction": "column",
              "alignItems": "center",
              "justifyContent": "start",
              "backgroundColor": "#1a2744",
              "paddingTop": "16dp",
              "paddingBottom": "16dp",
              "paddingLeft": "20dp",
              "paddingRight": "20dp",
              "scrollDirection": "vertical",
              "items": [

                {
                  "type": "Text",
                  "text": "${childData.petName != '' ? childData.petName : 'Your Pet'}",
                  "fontSize": "20dp",
                  "fontWeight": "700",
                  "color": "#FCD34D",
                  "textAlign": "center",
                  "marginBottom": "8dp"
                },

                {
                  "type": "Image",
                  "source": "${childData.petImage}",
                  "width": "180dp",
                  "height": "190dp",
                  "scale": "best-fit",
                  "align": "center"
                },

                {
                  "type": "Text",
                  "text": "${childData.stateLabel}",
                  "fontSize": "15dp",
                  "color": "#D1D5DB",
                  "textAlign": "center",
                  "marginTop": "8dp"
                },

                {
                  "type": "Container",
                  "when": "${childData.namingUnlocked}",
                  "backgroundColor": "#7C3AED",
                  "borderRadius": "12dp",
                  "paddingLeft": "16dp",
                  "paddingRight": "16dp",
                  "paddingTop": "8dp",
                  "paddingBottom": "8dp",
                  "marginTop": "10dp",
                  "width": "100%",
                  "items": [
                    {
                      "type": "Text",
                      "text": "🎉 Name your pet!\nSay 'name my pet'",
                      "fontSize": "13dp",
                      "color": "#EDE9FE",
                      "textAlign": "center"
                    }
                  ]
                },

                {
                  "type": "Container",
                  "marginTop": "12dp",
                  "width": "100%",
                  "items": [

                    {
                      "type": "Container",
                      "when": "${childData.interactionsUnlocked && !childData.allInteractionsDone}",
                      "backgroundColor": "#4C1D95",
                      "borderRadius": "10dp",
                      "paddingLeft": "10dp",
                      "paddingRight": "10dp",
                      "paddingTop": "7dp",
                      "paddingBottom": "7dp",
                      "marginBottom": "10dp",
                      "width": "100%",
                      "items": [{
                        "type": "Text",
                        "text": "✨ Thriving! Pet rewards unlocked!",
                        "fontSize": "12dp",
                        "color": "#DDD6FE",
                        "textAlign": "center"
                      }]
                    },

                    {
                      "type": "Container",
                      "when": "${childData.allInteractionsDone}",
                      "backgroundColor": "#166534",
                      "borderRadius": "10dp",
                      "paddingLeft": "10dp",
                      "paddingRight": "10dp",
                      "paddingTop": "7dp",
                      "paddingBottom": "7dp",
                      "marginBottom": "10dp",
                      "width": "100%",
                      "items": [{
                        "type": "Text",
                        "text": "🌟 All done! See you tomorrow!",
                        "fontSize": "12dp",
                        "color": "#86EFAC",
                        "textAlign": "center"
                      }]
                    },

                    {
                      "type": "Container",
                      "direction": "row",
                      "justifyContent": "spaceAround",
                      "alignItems": "center",
                      "width": "100%",
                      "items": [

                        {
                          "type": "Container",
                          "when": "${!childData.interactionsUnlocked}",
                          "width": "82dp",
                          "height": "72dp",
                          "backgroundColor": "#1f2937",
                          "borderRadius": "12dp",
                          "borderWidth": "1dp",
                          "borderColor": "#374151",
                          "alignItems": "center",
                          "justifyContent": "center",
                          "items": [
                            { "type": "Text", "text": "🔒", "fontSize": "20dp", "textAlign": "center" },
                            { "type": "Text", "text": "Feed", "fontSize": "11dp", "color": "#4B5563", "textAlign": "center", "marginTop": "2dp" }
                          ]
                        },
                        {
                          "type": "TouchWrapper",
                          "when": "${childData.interactionsUnlocked && !childData.interactions.fed}",
                          "onPress": { "type": "SendEvent", "arguments": ["feedPet", "${childData.childId}"] },
                          "item": {
                            "type": "Container",
                            "width": "82dp",
                            "height": "72dp",
                            "backgroundColor": "#EA580C",
                            "borderRadius": "12dp",
                            "alignItems": "center",
                            "justifyContent": "center",
                            "items": [
                              { "type": "Text", "text": "🍖", "fontSize": "20dp", "textAlign": "center" },
                              { "type": "Text", "text": "Feed", "fontSize": "12dp", "color": "#FFF7ED", "fontWeight": "600", "textAlign": "center", "marginTop": "2dp" }
                            ]
                          }
                        },
                        {
                          "type": "Container",
                          "when": "${childData.interactionsUnlocked && childData.interactions.fed}",
                          "width": "82dp",
                          "height": "72dp",
                          "backgroundColor": "#166534",
                          "borderRadius": "12dp",
                          "alignItems": "center",
                          "justifyContent": "center",
                          "items": [
                            { "type": "Text", "text": "✅", "fontSize": "20dp", "textAlign": "center" },
                            { "type": "Text", "text": "Fed!", "fontSize": "12dp", "color": "#86EFAC", "fontWeight": "600", "textAlign": "center", "marginTop": "2dp" }
                          ]
                        },

                        {
                          "type": "Container",
                          "when": "${!childData.interactionsUnlocked}",
                          "width": "82dp",
                          "height": "72dp",
                          "backgroundColor": "#1f2937",
                          "borderRadius": "12dp",
                          "borderWidth": "1dp",
                          "borderColor": "#374151",
                          "alignItems": "center",
                          "justifyContent": "center",
                          "items": [
                            { "type": "Text", "text": "🔒", "fontSize": "20dp", "textAlign": "center" },
                            { "type": "Text", "text": "Water", "fontSize": "11dp", "color": "#4B5563", "textAlign": "center", "marginTop": "2dp" }
                          ]
                        },
                        {
                          "type": "TouchWrapper",
                          "when": "${childData.interactionsUnlocked && !childData.interactions.watered}",
                          "onPress": { "type": "SendEvent", "arguments": ["waterPet", "${childData.childId}"] },
                          "item": {
                            "type": "Container",
                            "width": "82dp",
                            "height": "72dp",
                            "backgroundColor": "#0369A1",
                            "borderRadius": "12dp",
                            "alignItems": "center",
                            "justifyContent": "center",
                            "items": [
                              { "type": "Text", "text": "💧", "fontSize": "20dp", "textAlign": "center" },
                              { "type": "Text", "text": "Water", "fontSize": "12dp", "color": "#E0F2FE", "fontWeight": "600", "textAlign": "center", "marginTop": "2dp" }
                            ]
                          }
                        },
                        {
                          "type": "Container",
                          "when": "${childData.interactionsUnlocked && childData.interactions.watered}",
                          "width": "82dp",
                          "height": "72dp",
                          "backgroundColor": "#166534",
                          "borderRadius": "12dp",
                          "alignItems": "center",
                          "justifyContent": "center",
                          "items": [
                            { "type": "Text", "text": "✅", "fontSize": "20dp", "textAlign": "center" },
                            { "type": "Text", "text": "Watered!", "fontSize": "11dp", "color": "#86EFAC", "fontWeight": "600", "textAlign": "center", "marginTop": "2dp" }
                          ]
                        },

                        {
                          "type": "Container",
                          "when": "${!childData.interactionsUnlocked}",
                          "width": "82dp",
                          "height": "72dp",
                          "backgroundColor": "#1f2937",
                          "borderRadius": "12dp",
                          "borderWidth": "1dp",
                          "borderColor": "#374151",
                          "alignItems": "center",
                          "justifyContent": "center",
                          "items": [
                            { "type": "Text", "text": "🔒", "fontSize": "20dp", "textAlign": "center" },
                            { "type": "Text", "text": "Play", "fontSize": "11dp", "color": "#4B5563", "textAlign": "center", "marginTop": "2dp" }
                          ]
                        },
                        {
                          "type": "TouchWrapper",
                          "when": "${childData.interactionsUnlocked && !childData.interactions.played}",
                          "onPress": { "type": "SendEvent", "arguments": ["playPet", "${childData.childId}"] },
                          "item": {
                            "type": "Container",
                            "width": "82dp",
                            "height": "72dp",
                            "backgroundColor": "#7C3AED",
                            "borderRadius": "12dp",
                            "alignItems": "center",
                            "justifyContent": "center",
                            "items": [
                              { "type": "Text", "text": "🎾", "fontSize": "20dp", "textAlign": "center" },
                              { "type": "Text", "text": "Play", "fontSize": "12dp", "color": "#EDE9FE", "fontWeight": "600", "textAlign": "center", "marginTop": "2dp" }
                            ]
                          }
                        },
                        {
                          "type": "Container",
                          "when": "${childData.interactionsUnlocked && childData.interactions.played}",
                          "width": "82dp",
                          "height": "72dp",
                          "backgroundColor": "#166534",
                          "borderRadius": "12dp",
                          "alignItems": "center",
                          "justifyContent": "center",
                          "items": [
                            { "type": "Text", "text": "✅", "fontSize": "20dp", "textAlign": "center" },
                            { "type": "Text", "text": "Played!", "fontSize": "11dp", "color": "#86EFAC", "fontWeight": "600", "textAlign": "center", "marginTop": "2dp" }
                          ]
                        }

                      ]
                    }

                  ]
                }

              ]
            },

            {
              "type": "Container",
              "grow": 1,
              "direction": "column",
              "paddingTop": "16dp",
              "paddingBottom": "16dp",
              "paddingLeft": "24dp",
              "paddingRight": "24dp",
              "items": [

                {
                  "type": "Text",
                  "text": "Tap a chore to check it off!",
                  "fontSize": "16dp",
                  "color": "#6B7280",
                  "marginBottom": "12dp"
                },

                {
                  "type": "Sequence",
                  "scrollDirection": "vertical",
                  "grow": 1,
                  "width": "100%",
                  "data": "${childData.chores}",
                  "item": {
                    "type": "TouchWrapper",
                    "marginBottom": "12dp",
                    "onPress": {
                      "type": "SendEvent",
                      "arguments": ["toggleChore", "${childData.childId}", "${data.id}"]
                    },
                    "item": {
                      "type": "Container",
                      "backgroundColor": "${data.done ? '#14532d' : '#1f2937'}",
                      "borderRadius": "12dp",
                      "borderWidth": "1dp",
                      "borderColor": "${data.done ? '#4ADE80' : '#374151'}",
                      "paddingLeft": "20dp",
                      "paddingRight": "20dp",
                      "paddingTop": "16dp",
                      "paddingBottom": "16dp",
                      "direction": "row",
                      "alignItems": "center",
                      "items": [
                        {
                          "type": "Container",
                          "width": "40dp",
                          "height": "40dp",
                          "borderRadius": "20dp",
                          "borderWidth": "3dp",
                          "borderColor": "${data.done ? '#4ADE80' : '#9CA3AF'}",
                          "backgroundColor": "${data.done ? '#4ADE80' : '#374151'}",
                          "alignItems": "center",
                          "justifyContent": "center",
                          "marginRight": "16dp",
                          "items": [
                            {
                              "type": "Text",
                              "text": "${data.done ? '✓' : '○'}",
                              "fontSize": "20dp",
                              "color": "${data.done ? '#111827' : '#9CA3AF'}",
                              "fontWeight": "700",
                              "textAlign": "center"
                            }
                          ]
                        },
                        {
                          "type": "Text",
                          "text": "${data.name}",
                          "fontSize": "20dp",
                          "color": "${data.done ? '#86EFAC' : '#F9FAFB'}",
                          "fontWeight": "${data.done ? '400' : '600'}",
                          "grow": 1
                        }
                      ]
                    }
                  }
                }

              ]
            }

          ]
        }

      ]
    }
  }
}
